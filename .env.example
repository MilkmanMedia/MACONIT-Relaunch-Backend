# Copy to .env and fill in real values before running `npm run dev`.

# Postgres connection string (per Relaunch-Konzept Kapitel 6: production DB adapter).
# For quick local testing without a Postgres server, see README "Lokale Entwicklung ohne Postgres"
# for the @payloadcms/db-sqlite swap.
DATABASE_URI=postgresql://user:password@localhost:5432/maconit

# Long random string used to sign Payload's auth cookies/tokens. Generate e.g. with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL (used for absolute links, sitemap, metadata).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
